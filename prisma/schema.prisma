// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  zernioConnection  ZernioConnection?
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  serviceKeys       ServiceKey[]

  // Facebook Pages / Messenger, bot knowledge base and handoff alerts.
  // Relation fields only: Prisma needs both sides of a relation, and these
  // add no column to the Workspace table.
  facebookPages    FacebookPage[]
  botSettings      BotSettings?
  knowledgeEntries KnowledgeEntry[]
  alertSettings    AlertSettings?
  alertRecipients  AlertRecipient[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model ServiceKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  scopes      String[]
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  provider          InstagramProvider @default(META)
  /// Which Meta setup issued the token, for META accounts. Existing rows are
  /// INSTAGRAM: their tokens only work on graph.instagram.com. UNIFIED tokens
  /// are business system user tokens that only work on graph.facebook.com.
  metaLogin         MetaLogin @default(INSTAGRAM)
  zernioAccountId   String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum InstagramProvider {
  META
  ZERNIO
}

/// Instagram Login (Business Login for Instagram) or Meta's Unified login.
enum MetaLogin {
  INSTAGRAM
  UNIFIED
}

model ZernioConnection {
  workspaceId    String @id
  apiKey         String
  profileId      String?
  webhookId      String?
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}

// ─── Facebook Pages / Messenger ─────────────────────────────────────────────
//
// A separate channel next to Instagram. None of these tables is read by the
// Instagram code paths, and none of the Instagram tables is changed by them.

enum FacebookPageStatus {
  ACTIVE
  TOKEN_INVALID
  DISCONNECTED
}

/// A Facebook Page connected with a long-lived Page access token.
model FacebookPage {
  id                  String             @id @default(cuid())
  workspaceId         String
  /// The Page ID, which is entry.id in webhooks. One Page belongs to one
  /// workspace, so two brands can never share its conversations.
  pageId              String             @unique
  name                String
  pictureUrl          String?
  /// AES-256-GCM (lib/meta/oauth encryptToken). Never sent to the browser.
  accessToken         String
  tokenLast4          String?
  /// null when the token does not expire.
  tokenExpiresAt      DateTime?
  dataAccessExpiresAt DateTime?
  grantedScopes       String[]           @default([])
  /// Webhook fields this app is subscribed to on the Page.
  subscribedFields    String[]           @default([])
  webhookSubscribed   Boolean            @default(false)
  botEnabled          Boolean            @default(true)
  status              FacebookPageStatus @default(ACTIVE)
  lastError           String?
  lastWebhookAt       DateTime?
  tokenCheckedAt      DateTime?
  connectedAt         DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns     FacebookCampaign[]
  commentLogs   FacebookCommentLog[]
  conversations FacebookConversation[]

  @@index([workspaceId])
}

/// Comment keyword → private reply with a link button to the landing page.
model FacebookCampaign {
  id                  String   @id @default(cuid())
  workspaceId         String
  facebookPageId      String
  name                String
  /// "<pageId>_<postId>" as sent in feed webhooks; null with matchAnyPost.
  postId              String?
  postPermalink       String?
  postPreview         String?
  matchAnyPost        Boolean  @default(false)
  keywords            String[]
  matchAnyWord        Boolean  @default(false)
  wholeWordMatch      Boolean  @default(true)
  /// Supports {name}.
  privateReplyMessage String
  /// Meta caps button titles at 20 characters.
  buttonLabel         String
  landingUrl          String
  addUtm              Boolean  @default(true)
  publicReplyEnabled  Boolean  @default(false)
  publicReplyMessages String[] @default([])
  /// What the campaign is about, given to the bot for conversations it starts.
  botContext          String?
  /// The catalog product the campaign promotes: the bot gets its full card.
  productId           String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  page        FacebookPage         @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  commentLogs FacebookCommentLog[]
  product     Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([facebookPageId, isActive])
  @@index([postId])
}

enum FacebookCommentStatus {
  PENDING
  SENT
  FAILED
  /// The send may have gone through. Never retried automatically.
  UNCONFIRMED
  /// Older than the 7 days Meta allows for a private reply.
  SKIPPED_EXPIRED
  /// Meta 10900, or another campaign already used the one private reply.
  SKIPPED_ALREADY_REPLIED
  /// Meta 10903 / 551: this person cannot receive a private reply.
  SKIPPED_NOT_ELIGIBLE
  SKIPPED_RATE_LIMIT
}

/// One row per matched comment. The unique key is what enforces Meta's rule
/// of a single private reply per comment, across retries and campaigns.
model FacebookCommentLog {
  id                             String                @id @default(cuid())
  workspaceId                    String
  facebookPageId                 String
  campaignId                     String?
  commentId                      String
  postId                         String
  parentId                       String?
  commenterId                    String?
  commenterName                  String?
  commentText                    String
  commentCreatedAt               DateTime
  matchedKeyword                 String?
  status                         FacebookCommentStatus @default(PENDING)
  attempts                       Int                   @default(0)
  /// Claim flag set before the send, cleared only by a confirmed outcome.
  deliveryUnconfirmed            Boolean               @default(false)
  privateReplySentAt             DateTime?
  recipientPsid                  String?
  privateReplyMessageId          String?
  errorMessage                   String?
  publicReplyDeliveryUnconfirmed Boolean               @default(false)
  publicReplySentAt              DateTime?
  publicReplyCommentId           String?
  publicReplyError               String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  page     FacebookPage      @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  campaign FacebookCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([facebookPageId, commentId])
  @@index([workspaceId, createdAt])
  @@index([campaignId])
  @@index([status])
}

/// Why a conversation was handed to a person. Drives alert routing.
enum HandoffCategory {
  WHOLESALE_ORDER
  CUSTOM_ORDER
  COMPLAINT
  NOT_IN_KB
  AUDIO_FAILED
  OTHER
  /// The bot collected every detail of an order: a person confirms it (phase 11).
  ORDER_READY
}

/// The customer's state, as the model reads it in each of its answers (phase 11).
enum CustomerState {
  NEUTRAL
  PRICE_ONLY
  HESITANT
  READY_TO_BUY
  ANGRY
  WHOLESALE
  CUSTOM_ORDER
}

enum FacebookConversationMode {
  BOT
  HUMAN
}

enum FacebookModeReason {
  /// The bot asked for a person.
  BOT_HANDOFF
  /// Someone clicked "take over" in OpenReply.
  INBOX_TAKEOVER
  /// A person replied from Meta Business Suite or the Pages app.
  META_REPLY
  /// Returned to the bot from the inbox.
  INBOX_RELEASE
  /// The bot came back on its own: nobody from the team answered in time.
  AUTO_RESUME
}

model FacebookConversation {
  id               String                   @id @default(cuid())
  workspaceId      String
  facebookPageId   String
  /// Page-scoped user ID.
  psid             String
  userName         String?
  mode             FacebookConversationMode @default(BOT)
  modeReason       FacebookModeReason?
  modeChangedAt    DateTime?
  needsHuman       Boolean                  @default(false)
  handoffCategory  HandoffCategory?
  handoffReason    String?
  handoffAt        DateTime?
  sourceCampaignId String?
  sourceCommentId  String?
  /// The 24-hour standard messaging window runs from the last inbound message.
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  lastMessageText  String?
  lastMessageAt    DateTime?
  unreadCount      Int                      @default(0)
  /// Catalog products the conversation is about (named, from the campaign, recognised in a photo).
  focusProductIds  String[]                 @default([])
  /// The customer's state at the bot's last answer.
  customerState    CustomerState?
  /// The order details collected so far (lib/bot/order.ts), until a person takes over.
  orderDraft       Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  page     FacebookPage                @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  messages FacebookMessage[]
  events   FacebookConversationEvent[]

  @@unique([facebookPageId, psid])
  @@index([workspaceId, needsHuman, lastMessageAt])
  @@index([workspaceId, handoffCategory])
}

enum FacebookMessageDirection {
  INBOUND
  OUTBOUND
}

enum FacebookMessageAuthor {
  CUSTOMER
  BOT
  HUMAN
  /// The private reply that opened the thread.
  CAMPAIGN
}

enum FacebookMessageOrigin {
  /// Sent through this app: the bot, a campaign, or the OpenReply inbox.
  OPENREPLY
  /// Seen only as an echo: Meta Business Suite, the Pages app, another tool.
  EXTERNAL
}

enum FacebookTranscriptStatus {
  PENDING
  DONE
  FAILED
}

enum FacebookSendStatus {
  PENDING
  SENT
  FAILED
  UNCONFIRMED
}

model FacebookMessage {
  id               String                    @id @default(cuid())
  workspaceId      String
  conversationId   String
  direction        FacebookMessageDirection
  author           FacebookMessageAuthor
  /// Outbound messages only.
  origin           FacebookMessageOrigin?
  /// The app_id an echo carried, kept to diagnose external senders.
  echoAppId        String?
  /// Messenger message ID. Unique, so a webhook retry never stores twice.
  mid              String?                   @unique
  /// For a bot reply: the inbound message it answers. Unique per
  /// conversation, so one trigger can never get two replies.
  replyToMid       String?
  text             String?
  attachmentType   String?
  attachmentUrl    String?
  transcript       String?
  transcriptStatus FacebookTranscriptStatus?
  sendStatus       FacebookSendStatus?
  error            String?
  /// The dashboard user who sent a HUMAN reply from the OpenReply inbox.
  sentByUserId     String?
  /// On a customer's message the bot answered: the customer's state the model read.
  customerState    CustomerState?
  /// A customer's photo: { status: PENDING | DONE | FAILED, recognition, error } (phase 12).
  imageAnalysis    Json?
  sentAt           DateTime                  @default(now())
  createdAt        DateTime                  @default(now())

  conversation FacebookConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, replyToMid])
  @@index([conversationId, sentAt])
}

enum FacebookConversationEventType {
  HANDOFF
  HUMAN_TAKEOVER
  RETURNED_TO_BOT
}

/// Conversation timeline. A HANDOFF event is what alerts are sent for.
model FacebookConversationEvent {
  id             String                        @id @default(cuid())
  workspaceId    String
  conversationId String
  type           FacebookConversationEventType
  category       HandoffCategory?
  reason         String?
  actorUserId    String?
  createdAt      DateTime                      @default(now())

  conversation FacebookConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

enum FacebookWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// Raw Page webhook deliveries for connected Pages, kept 30 days. Separate
/// from WebhookEvent so the Instagram comment sweep never scans them.
model FacebookWebhookEvent {
  id           String                @id @default(cuid())
  workspaceId  String?
  pageId       String?
  payload      Json
  status       FacebookWebhookStatus @default(RECEIVED)
  errorMessage String?
  createdAt    DateTime              @default(now())
  processedAt  DateTime?

  @@index([createdAt])
  @@index([pageId])
}

// ─── Bot knowledge base (per workspace, not tied to a channel) ──────────────

model BotSettings {
  workspaceId    String       @id
  enabled        Boolean      @default(false)
  businessName   String?
  /// Tone, dialect and extra rules from the workspace.
  instructions   String?
  handoffMessage String       @default("نرجعولك")
  /// Sent instead of handoffMessage when the bot came back on its own after a person went quiet.
  busyMessage    String       @default("الفريق مشغول ضرك، نتصلو بيك من بعد")
  /// The bot takes a conversation back when nobody from the team answered the customer for this
  /// many minutes (0: never).
  resumeAfterMinutes  Int     @default(20)
  /// Or when the customer sent this many messages in a row without a person answering (0: never).
  resumeAfterMessages Int     @default(3)
  /// Phase 11: the bot's persona, goal and sales playbook (lib/bot/persona.ts).
  personaName    String?
  personaStyle   String?
  /// null: the customer's own dialect.
  dialect        String?
  goal           BotGoal      @default(SELL)
  goalNotes      String?
  /// The order details collected before ORDER_READY (lib/bot/order.ts).
  orderFields    OrderField[] @default([WILAYA, COLOUR, QUANTITY, NAME, PHONE])
  /// null: the default playbook.
  playbook       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// What the bot aims for with the brand's customers.
enum BotGoal {
  SELL
  COLLECT_ORDER
  COLLECT_INFO
  ANSWER_ONLY
}

/// An order detail the bot can collect.
enum OrderField {
  WILAYA
  COLOUR
  QUANTITY
  NAME
  PHONE
  ADDRESS
}

enum KnowledgeEntryKind {
  PRODUCT
  DELIVERY
  FAQ
  RULE
  INFO
}

model KnowledgeEntry {
  id          String             @id @default(cuid())
  workspaceId String
  kind        KnowledgeEntryKind
  /// Product name, delivery zone, question or rule title.
  title       String
  content     String             @default("")
  /// Product price or delivery fee, quoted verbatim by the bot.
  price       String?
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, isActive])
}

// ─── Handoff alerts (per workspace, not tied to a channel) ──────────────────

enum AlertChannel {
  TELEGRAM
  EMAIL
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model AlertSettings {
  workspaceId         String   @id
  /// Telegram bot token from BotFather, encrypted. Never sent to the browser.
  telegramBotToken    String?
  /// From getMe, for display.
  telegramBotUsername String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AlertRecipient {
  id             String       @id @default(cuid())
  workspaceId    String
  channel        AlertChannel
  label          String
  /// A person or a group (group IDs are negative).
  telegramChatId String?
  email          String?
  /// Receives the alerts of categories that have no route.
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routes    AlertRoute[]

  @@index([workspaceId])
}

/// Routing table: which recipients get the alerts of a handoff category.
model AlertRoute {
  id          String          @id @default(cuid())
  workspaceId String
  category    HandoffCategory
  recipientId String
  createdAt   DateTime        @default(now())

  recipient AlertRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([category, recipientId])
  @@index([workspaceId, category])
}

/// One row per alert per recipient. dedupeKey stops a retried job from
/// sending the same alert twice.
model AlertDelivery {
  id             String              @id @default(cuid())
  workspaceId    String
  conversationId String?
  eventId        String?
  recipientId    String?
  channel        AlertChannel
  category       HandoffCategory?
  dedupeKey      String              @unique
  isTest         Boolean             @default(false)
  status         AlertDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  error          String?
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  @@index([workspaceId, createdAt])
}

// ─── Product catalog (per workspace) ────────────────────────────────────────
// Like AlertRoute and AlertDelivery, these tables hold workspaceId without a
// relation to Workspace, so the Workspace model keeps only the relation
// fields approved in PLAN.md (workspaces are never deleted in this app).

enum ProductAttributeType {
  TEXT
  NUMBER
  CHOICE
  BOOLEAN
}

enum ProductStatus {
  /// Extracted by the AI (posts, conversations, interview): waits for a person.
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductSource {
  MANUAL
  IMPORT
  POST
  CONVERSATION
  INTERVIEW
}

/// One of a brand's own product attributes (thickness, material, water resistance...).
model ProductAttribute {
  id          String               @id @default(cuid())
  workspaceId String
  /// Stable key of the value in Product.attributes, e.g. "thickness".
  key         String
  /// As the brand says it, e.g. "السمك".
  label       String
  type        ProductAttributeType @default(TEXT)
  unit        String?
  /// The choices of a CHOICE attribute.
  options     String[]             @default([])
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([workspaceId, key])
}

/// A product card. Prices are kept as written and quoted as they are.
model Product {
  id          String        @id @default(cuid())
  workspaceId String
  status      ProductStatus @default(ACTIVE)
  source      ProductSource @default(MANUAL)
  /// The post, conversation or interview it came from.
  sourceRef   String?
  /// The words a draft was read from (a post's sentence), shown while it waits for a person.
  sourceNote  String?
  name        String
  /// The product's code or number, as written.
  code        String?
  /// The code normalized for lookups (lib/catalog/codes.ts); unique in the brand.
  codeKey     String?
  price       String?
  available   Boolean       @default(true)
  landingUrl  String?
  /// Free text about the product, in the brand's words.
  description String?
  /// How to install or use it.
  howToUse    String?
  /// { [ProductAttribute.key]: value }
  attributes  Json          @default("{}")
  strengths   String[]      @default([])
  /// Compared with similar products or with competitors.
  comparisons String?
  /// The uses and places it suits.
  suitableFor String?
  /// [{ question, answer }]: the known questions and worries, with their answers.
  objections  Json          @default("[]")
  mainImageId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mainImage ProductImage?      @relation("ProductMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  images    ProductImage[]     @relation("ProductImages")
  variants  ProductVariant[]
  related   ProductRelation[]  @relation("ProductRelationFrom")
  relatedBy ProductRelation[]  @relation("ProductRelationTo")
  campaigns FacebookCampaign[]
  suggestions KnowledgeSuggestion[]

  @@unique([workspaceId, codeKey])
  @@index([workspaceId, status])
}

/// A colour or type of a product, with its own code and image.
model ProductVariant {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  /// As written on the post's photos, e.g. "12".
  code        String
  /// The code normalized for lookups.
  codeKey     String
  name        String?
  available   Boolean  @default(true)
  /// When it differs from the product's price.
  price       String?
  imageId     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@unique([productId, codeKey])
  @@index([workspaceId, codeKey])
}

/// A product image, kept in the database (so the daily backup holds it) and
/// served at /api/public/media/<publicId>, since Messenger fetches the images
/// it sends.
model ProductImage {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String?
  /// Random and unguessable: all the public URL reveals.
  publicId    String   @unique
  /// image/jpeg, image/png or image/webp, read from the bytes.
  mimeType    String
  size        Int
  sha256      String
  data        Bytes
  fileName    String?
  createdAt   DateTime @default(now())

  product   Product?         @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  mainOf    Product[]        @relation("ProductMainImage")
  variantOf ProductVariant[]

  @@index([workspaceId, productId])
}

/// An alternative or close product the bot may suggest.
model ProductRelation {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  relatedId   String
  /// Why it is suggested, e.g. "cheaper" or "thicker".
  note        String?
  createdAt   DateTime @default(now())

  product Product @relation("ProductRelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("ProductRelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
}

// ─── Filling the catalog and the knowledge base (phase 14) ──────────────────
// workspaceId without a relation to Workspace, like the catalog tables above.

enum SuggestionSource {
  POST
  CONVERSATION
  INTERVIEW
  HANDOFF_REPLY
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A suggestion to enrich a product card or the knowledge base. Applied only when a person approves it.
model KnowledgeSuggestion {
  id              String           @id @default(cuid())
  workspaceId     String
  source          SuggestionSource
  /// The thread, message, interview or post it came from.
  sourceRef       String?
  productId       String?
  /// "faq" | "delivery" | "product.strengths" | "product.objections" | "product.comparisons" | "product.suitableFor"
  target          String
  /// { question, answer } | { text } | { items }
  payload         Json
  /// The words it came from (a quote, a transcript), for the person who reviews it.
  evidence        String?
  /// Set when a re-run could offer the same suggestion again: it is stored once.
  dedupeKey       String?
  status          SuggestionStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, createdAt])
}

/// The voice interview on Telegram, product by product and question by question.
model KnowledgeInterview {
  id              String    @id @default(cuid())
  workspaceId     String
  /// The Telegram chat the questions go to.
  chatId          String
  /// ACTIVE | DONE | STOPPED (lib/knowledge/interview.ts)
  status          String
  productIds      String[]
  position        Int       @default(0)
  question        Int       @default(0)
  lastAskedAt     DateTime?
  startedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, status])
}

/// The next Telegram update the worker reads, per brand's bot.
model TelegramCursor {
  workspaceId String   @id
  /// The bot the offset belongs to (the token's numeric prefix): a new bot starts again from 0.
  botId       String?
  offset      BigInt   @default(0)
  updatedAt   DateTime @updatedAt
}

/// Chats that wrote to the brand's bot, for the alerts' chat picker once the worker reads the updates.
model TelegramChatSeen {
  workspaceId String
  chatId      String
  title       String?
  type        String
  lastSeenAt  DateTime

  @@id([workspaceId, chatId])
}

/// A Page post already read into drafts: the next reading skips it, so a draft a person rejected or merged never comes back.
model PostRead {
  workspaceId String
  /// The post's ID on Facebook.
  postId      String
  /// How many drafts it gave.
  drafts      Int      @default(0)
  readAt      DateTime @default(now())

  @@id([workspaceId, postId])
}
