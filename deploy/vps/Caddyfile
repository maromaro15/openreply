# One domain serves the dashboard and the webhooks, for example
# https://bot.example.com/api/facebook/webhook. Caddy gets and renews the
# Let's Encrypt certificate by itself once the DNS A record points here and
# ports 80 and 443 are open.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# Send bytes through as they arrive. Webhook signatures are checked on
		# the raw body, so nothing may buffer or rewrite it.
		flush_interval -1

		# Caddy already sets X-Forwarded-For/Proto/Host; the app builds its
		# allowed origins from them.

		# A slow Meta retry or a long AI answer should not be cut early.
		transport http {
			response_header_timeout 120s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
