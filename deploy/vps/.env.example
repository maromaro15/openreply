# OpenReply on a VPS. Copy to `.env` next to docker-compose.yml and fill it in.
#   cp .env.example .env && chmod 600 .env
# REQUIRED marks what the stack cannot start or work without.
# Do not use `$` or quotes inside values (Compose expands `$`).
# Never commit the real .env.

# ============================================================
# الدومين والشهادة | Domain and HTTPS
# ============================================================
# REQUIRED. The subdomain that serves the dashboard and the webhooks. Its DNS
# A record must point to this VPS before the first start.
DOMAIN=bot.example.com
# REQUIRED. Let's Encrypt sends expiry notices here.
ACME_EMAIL=you@example.com
# NEXTAUTH_URL is set by docker-compose.yml to https://$DOMAIN; do not add it.

# ============================================================
# قاعدة البيانات والطابور | Database and queue
# ============================================================
# REQUIRED. Used by Postgres and to build DATABASE_URL. Letters and digits only
# so it is safe inside a URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
# DATABASE_URL and REDIS_URL are set by docker-compose.yml; do not add them.
# Connections per process to Postgres (default 3).
# DB_POOL_MAX=10

# ============================================================
# الأسرار | Secrets
# ============================================================
# REQUIRED. Signs sessions and tracking links:  openssl rand -base64 32
NEXTAUTH_SECRET=
# REQUIRED. Protects /api/cron (also falls back to NEXTAUTH_SECRET):
#   openssl rand -base64 32
CRON_SECRET=
# REQUIRED. 64 hex characters (32 bytes). Encrypts the Page and Instagram tokens.
# Losing or changing it makes the stored tokens unreadable:  openssl rand -hex 32
ENCRYPTION_KEY=

# ============================================================
# تسجيل الدخول والبريد | Sign-in and email
# ============================================================
# REQUIRED for magic-link sign-in: either Resend...
RESEND_API_KEY=
# ...or your own SMTP server (takes over when set; URL-encode @ as %40):
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465
# REQUIRED. Sender of login emails.
EMAIL_FROM=OpenReply <login@example.com>
# Sender of handoff alert emails (defaults to EMAIL_FROM).
# ALERTS_EMAIL_FROM=
# Comma separated list of emails allowed to sign in. Empty means anyone who
# reaches the site can sign up, so set it on a public domain.
ALLOWED_EMAILS=
# Comma separated emails allowed to create new brands (workspaces). Empty:
# anyone who owns a workspace can (an invited brand team member cannot).
AGENCY_OWNER_EMAILS=
# Interface language before a visitor chooses one: ar, en, es, pt-BR, ru or
# zh-TW (English when unset).
DEFAULT_LOCALE=ar

# ============================================================
# فيسبوك وماسنجر | Facebook Pages and Messenger
# ============================================================
# REQUIRED for Facebook. Meta app ID (App settings > Basic).
FACEBOOK_APP_ID=
# REQUIRED. Verifies webhook signatures and tokens.
FACEBOOK_APP_SECRET=
# REQUIRED. Any random string; paste the same value in the Meta webhook
# settings. Webhook URL: https://$DOMAIN/api/facebook/webhook
#   openssl rand -hex 16
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Graph API version (defaults to META_GRAPH_API_VERSION, then v25.0).
# FACEBOOK_GRAPH_API_VERSION=v25.0
# Parallel Facebook jobs, 1-50.
FACEBOOK_WORKER_CONCURRENCY=5
# Largest voice message accepted, in bytes (max 19922944).
FACEBOOK_AUDIO_MAX_BYTES=15728640
# Days to keep raw webhook events, 1-365.
FACEBOOK_WEBHOOK_RETENTION_DAYS=30
# Allow human replies up to 7 days. Needs Meta's approval first.
FACEBOOK_HUMAN_AGENT_TAG=false
# ffmpeg is installed in the Facebook worker image; leave as is.
FFMPEG_PATH=ffmpeg

# ============================================================
# الذكاء الاصطناعي | AI (Gemini)
# ============================================================
# REQUIRED for the bot and voice transcription. Server side only.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
# Overrides the transcription instruction (default: Algerian Darija, French or Arabic).
# GEMINI_TRANSCRIBE_PROMPT=
# Left to the model when unset (0 to 2). Google advises the default for Gemini 3.
# GEMINI_TEMPERATURE=
# Milliseconds the bot waits for the customer to finish typing, 0-60000.
BOT_DEBOUNCE_MS=7000
# Messages of the conversation the bot reads, 1-50.
BOT_HISTORY_MESSAGES=20
# Full product cards sent to the model per answer, 1-20.
BOT_MAX_FULL_CARDS=8
# Product photo upload limit, bytes.
PRODUCT_IMAGE_MAX_BYTES=5242880
# Largest customer photo the bot reads, bytes.
CUSTOMER_IMAGE_MAX_BYTES=8388608
# Product pictures compared with a customer photo that shows no code, 1-10.
IMAGE_MATCH_MAX_CANDIDATES=6
# The model that reads photos (defaults to GEMINI_CHAT_MODEL).
# GEMINI_VISION_MODEL=
# The worker reads the alerts Telegram bot while a voice interview runs.
# false turns the interview's reading off.
TELEGRAM_POLLING=true

# ============================================================
# انستغرام | Instagram (skip if you only use Facebook)
# ============================================================
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram webhook verify token (also the fallback for the Facebook one).
WEBHOOK_VERIFY_TOKEN=
# Only for Meta apps that use "API setup with Unified login":
# META_LOGIN_CONFIG_ID=
# META_APP_ID=
# Instagram comment polling: interval ms, lookback hours, maximum new comments
# per campaign per sweep. Leave unset (not empty) to use these defaults.
# COMMENT_POLL_INTERVAL_MS=300000
# COMMENT_POLL_LOOKBACK_HOURS=72
# COMMENT_POLL_MAX_PER_SWEEP=30
# Pace comment DMs to at most this many per hour per account (unset: no pacing).
# COMMENT_DM_MAX_PER_HOUR=80
# Follow re-check: delays in ms (comma separated) and an optional
# acknowledgement text sent to the customer.
# FOLLOW_RECHECK_DELAYS_MS=20000,40000
# FOLLOW_RECHECK_ACK_MESSAGE=

# ============================================================
# المراقبة والتقارير | Monitoring and extras
# ============================================================
# Jobs waiting with none active before /api/health reports a stuck queue.
# HEALTH_STUCK_QUEUE_WAITING=25
# Optional GitHub token (no scopes) for the star count on the public pages.
# GITHUB_TOKEN=

# ============================================================
# النسخ الاحتياطي | Backups (read by backup.sh, not by the app)
# ============================================================
# Folder for dumps on the host (default: ./backups next to backup.sh).
# BACKUP_DIR=/var/backups/openreply
# How many dumps to keep (default 14).
# BACKUP_KEEP=14
# Optional command run with the new dump path as $1, to copy it off the VPS,
# e.g.  rclone copyto "$1" remote:openreply/$(basename "$1")
# BACKUP_UPLOAD_CMD=
