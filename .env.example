# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379
# Only for docker-compose.app.yml, and only if you changed the credentials in
# docker-compose.yml. Inside the containers the hosts are the service names.
# DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/openreply
# DOCKER_REDIS_URL=redis://redis:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Amitec Reply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: who may edit the global brand-voice set (the example conversations
# and the correction dictionary every brand gets). Without it, brands edit only
# their own. Comma separated, case insensitive.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional: Meta apps created from October 2026 only offer "API setup with
# Unified login". Set its login configuration ID to connect new accounts that
# way, with the Meta app's own ID (App settings > Basic) and FACEBOOK_APP_SECRET.
# The configuration needs business_management (see docs/setup.md). Accounts
# already connected through Instagram Login keep working either way.
# META_LOGIN_CONFIG_ID=
# META_APP_ID=

# Optional. A GitHub token (no scopes needed) raises the rate limit for the star count
# and contributors list on the public pages. Without it they fall back to asking
# GitHub from the visitor's browser.
# GITHUB_TOKEN=

# ─── Facebook Pages / Messenger, the bot, the catalog and alerts ────────────
# Everything below is for the Facebook module (PLAN.md section 7). Instagram
# works without it. Guide in Arabic: docs/ar/; server setup: deploy/vps/.

# Meta app ID (App settings > Basic); falls back to META_APP_ID.
FACEBOOK_APP_ID=your-meta-app-id
# FACEBOOK_APP_SECRET (above) verifies the webhook signatures and the tokens.
# Webhook: https://your-domain/api/facebook/webhook, fields feed, messages,
# message_echoes and messaging_postbacks. Falls back to WEBHOOK_VERIFY_TOKEN.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=replace-with-a-facebook-verify-token
# Graph API version; falls back to META_GRAPH_API_VERSION, then v25.0.
# FACEBOOK_GRAPH_API_VERSION=v25.0
# Parallel jobs in the Facebook worker (npm run worker:facebook), 1-50.
# FACEBOOK_WORKER_CONCURRENCY=5
# Let a person reply up to 7 days after the customer wrote (HUMAN_AGENT tag).
# Turn it on only once Meta approved the permission.
# FACEBOOK_HUMAN_AGENT_TAG=false
# Days the raw webhook deliveries are kept, 1-365.
# FACEBOOK_WEBHOOK_RETENTION_DAYS=30
# Largest voice message transcribed, in bytes.
# FACEBOOK_AUDIO_MAX_BYTES=15728640
# The ffmpeg binary that converts voice messages for transcription.
# FFMPEG_PATH=ffmpeg

# Who may create brands (workspaces), comma separated. Empty: anyone who owns
# a workspace can; an invited brand team member cannot.
# AGENCY_OWNER_EMAILS=

# Gemini (Google AI Studio key), server side only. Without it every message is
# handed to a person, and voice messages and photos are not read.
GOOGLE_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
# The model that reads customers' photos (defaults to GEMINI_CHAT_MODEL).
# GEMINI_VISION_MODEL=
# Replaces the transcription instruction (Algerian Darija, French or Arabic).
# GEMINI_TRANSCRIBE_PROMPT=
# 0 to 2; left to the model when unset.
# GEMINI_TEMPERATURE=
# Milliseconds the bot waits for the customer to finish typing, 0-60000.
# BOT_DEBOUNCE_MS=7000
# Messages of the conversation the bot reads, 1-50.
# BOT_HISTORY_MESSAGES=20
# Full product cards given to the model per answer, 1-20.
# BOT_MAX_FULL_CARDS=8

# Product pictures (upload limit, bytes) and customers' photos read by the bot.
# PRODUCT_IMAGE_MAX_BYTES=5242880
# CUSTOMER_IMAGE_MAX_BYTES=8388608
# Product pictures compared with a customer photo that shows no code, 1-10.
# IMAGE_MATCH_MAX_CANDIDATES=6

# Sender of handoff alert emails (defaults to EMAIL_FROM).
# ALERTS_EMAIL_FROM=
# The Facebook worker reads the brand's alerts Telegram bot while a voice
# interview runs; false turns that off.
# TELEGRAM_POLLING=true

# Interface language before a visitor chooses one: ar, en, es, pt-BR, ru or
# zh-TW. English when unset.
# DEFAULT_LOCALE=ar
